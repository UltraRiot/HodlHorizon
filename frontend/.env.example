# Copy to .env.local

# Where the Express backend is running.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional, cookieless, privacy-friendly analytics (e.g. Plausible).
# Leave blank to run with no analytics at all - nothing loads if it's empty.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# The real production domain - every canonical link, OG/Twitter image URL,
# NewsArticle JSON-LD field, and sitemap.xml entry is built from this
# (components/Seo.js, pages/article/[slug].js, pages/sitemap.xml.js).
# Falls back to "https://hodlhorizon.com" when unset, which happens to be
# correct for this project today, but a real production deploy should set
# this explicitly rather than rely on that fallback matching by accident.
NEXT_PUBLIC_SITE_URL=https://hodlhorizon.com
