# Copy this file to .env and fill in your own values.

# --- Database ---
DATABASE_URL=postgres://hodlhorizon:hodlhorizon@localhost:5432/hodlhorizon

# --- Server ---
PORT=4000
FRONTEND_URL=http://localhost:3000

# --- Admin login (used by seed.js to create the first admin account) ---
ADMIN_EMAIL=admin@hodlhorizon.com
ADMIN_PASSWORD=change-this-password
JWT_SECRET=change-this-to-a-long-random-string

# --- AI provider ---
# "mock" needs no API key and is the default - it writes clearly-labelled
# placeholder articles so you can test the whole pipeline for free.
# Switch to "openai" or "anthropic" once you add a real key below.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- Content scanning ---
# How often (in minutes) the AI engine scans RSS sources for new stories.
SCAN_INTERVAL_MINUTES=15
# An article only auto-publishes once this many independent sources report
# the same story. Anything below this goes to "In Review" instead.
AUTO_PUBLISH_MIN_SOURCES=2
# How often (in hours) the separate Analysis job runs. It only writes a new
# article when an asset's numbers actually moved, so this can be infrequent.
ANALYSIS_INTERVAL_HOURS=12

# --- Market data ---
# Crypto prices/movers use CoinGecko's free public API - no key needed to
# run at all, but see COINGECKO_API_KEY below for why you should still add
# one.
#
# COINGECKO_API_KEY (optional) - CoinGecko's free "Demo" plan key
# (coingecko.com/en/api/pricing - no cost, no credit card). Real, repeated
# problem this fixes: the keyless public endpoint used above consistently
# 429'd this project after roughly 5 rapid successive calls during live
# verification batches. A Demo key raises that to 100 calls/min and a
# ~10,000/month credit cap. Drop a real key in here and every existing
# CoinGecko call (services/marketData/prices.js's shared getJson() helper)
# automatically sends it - no further code change needed. Leave blank to
# keep today's keyless (rate-limited) behavior.
COINGECKO_API_KEY=
#
# TWELVEDATA_API_KEY is the primary market-data key (free "Basic" tier:
# 800 credits/day, 1 call = 1 credit for both /quote and /time_series).
# Powers all of the following, all real data, none of it fetched per page
# load, ~83 credits/day total across every schedule below:
#   - Header ticker bar: SPY/QQQ/DIA index quotes and Gold (real spot gold,
#     Twelve Data's XAU/USD - not an ETF proxy) quote+history, plus SPY's
#     own history (services/marketData/refreshMarketData.js, hourly/
#     8-hourly/daily cron schedule, ~77 credits/day).
#   - The Markets Overview strip's forex (EUR/USD, GBP/USD, USD/JPY) and
#     individual-stock (AAPL, NVDA, MSFT) columns (services/marketData/
#     overviewCache.js, refreshed on a request-triggered staleness check,
#     6 credits per refresh).
#   - Leave blank to disable all of the above - each one is simply omitted
#     (never a fabricated/sample number) when this key is unset.
# During local development, see MARKET_DATA_DRY_RUN below instead of using
# a real key here - it exercises the same code paths without spending any
# real daily quota (yours or the production site's).
TWELVEDATA_API_KEY=

# STOCKS_DATA_API_KEY is an Alpha Vantage key (free tier: 25 requests/day) -
# narrowed to just WTI crude oil, Brent crude, and Natural Gas. Everything
# else that used to run on this key (Gold, SPY history, forex, individual
# stocks) migrated to Twelve Data above once confirmed that Twelve Data's
# free tier covers real spot gold (XAU/USD, categorized as a forex pair)
# and stock/forex time_series. WTI/Brent/Natural Gas stayed here because
# Twelve Data's true "commodities" catalog is a paid-plan feature per
# their pricing page - unconfirmed as available on the free Basic tier.
# Powers:
#   - The scheduled market-data cache's WTI crude quote+history
#     (services/marketData/refreshMarketData.js/alphaVantage.js, ~4
#     requests/day on its own 8-hourly/daily cron schedule).
#   - The Markets Overview strip's Brent/Natural Gas columns
#     (services/marketData/overviewCache.js, 2 requests per refresh).
#   ~6 requests/day total. Leave blank to disable all of the above - each
#   one is simply omitted (never a fabricated/sample number) when this key
#   is unset.
# During local development, see MARKET_DATA_DRY_RUN below instead of using
# a real key here - it exercises the same code paths without spending any
# real daily quota (yours or the production site's).
STOCKS_DATA_API_KEY=

# FINNHUB_API_KEY (evaluated, not yet wired into any live feature) -
# finnhub.io's free tier: ~60 calls/min, real-time US stock quotes,
# forex rates, crypto data, and basic fundamentals, no credit card
# required - a genuinely generous free tier, comparable in breadth to
# Twelve Data's. Third-party sources describe the free tier as scoped to
# personal/non-commercial use, with monetized apps needing a paid plan -
# could not independently confirm the exact wording directly from
# Finnhub's own ToS (their pricing/docs pages are JS-rendered and didn't
# return full content to a plain fetch), so verify that restriction
# against Finnhub's current terms before relying on it commercially.
# Placeholder only for now: adding a key here does NOT unlock anything by
# itself, since no code path reads it yet - it's a real, viable candidate
# either as redundancy for Twelve Data (same asset classes, so it could
# stand in when Twelve Data's 800/day cap is hit) or as an Alpha Vantage
# replacement for WTI/Brent/Natural Gas (unconfirmed whether Finnhub's
# free tier includes commodities/futures - its own marketing only
# mentions stocks/forex/crypto). Which role it should play is a real
# design decision, not a drop-in - build the integration once that's
# decided.
FINNHUB_API_KEY=

# MASSIVE_API_KEY (confirmed identity, not integrated) - massive.com is a
# real, distinct financial market data platform (stocks, options, indices,
# forex, crypto, futures, institutional-grade with direct exchange
# connectivity) - it is NOT Marketstack.com, a different and much simpler
# stocks-only API; the two were confirmed as separate products before
# evaluating either. Massive's free "Stocks Basic" tier: all US tickers,
# end-of-day only (no real-time/intraday), 5 calls/min, 2 years of
# history - every other asset class (forex, crypto, indices, futures) is
# paid-tier only. Not integrated: its free tier doesn't clearly add
# coverage this project doesn't already have for free (Twelve Data covers
# real-time stocks/forex already; CoinGecko covers crypto). Add a key here
# only if a specific need for its EOD stock data or paid multi-asset tiers
# comes up - no code currently reads this variable.
MASSIVE_API_KEY=

# Set this to true in your local .env during development so testing the
# market-data pipeline never spends the production site's real daily
# quota. When true, services/marketData/twelveData.js and alphaVantage.js
# return canned (clearly fake, not fabricated-looking) responses instead
# of calling Twelve Data/Alpha Vantage at all - no key required either.
# Logged loudly on server startup so it's never silently on by accident.
# Defaults to true here so a fresh local checkout is dry-run out of the
# box; a real deploy's .env should have this unset or false.
MARKET_DATA_DRY_RUN=true

# --- Admin alert emails ---
# Fired the moment a single-source article is scheduled to auto-publish
# (see services/notifications/mailer.js and scanAndGenerate.js) - the
# delayed-auto-publish review window is only a real chance to intervene
# if something actually tells you it's open. Leave ADMIN_ALERT_EMAIL
# blank to disable this entirely (logged once, not an error) - nothing
# else here requires it.
#
# Simplest zero-new-signup option: a Gmail account with an "app password"
# (myaccount.google.com/apppasswords) - SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=587, SMTP_USER=youraddress@gmail.com, SMTP_PASS=<the 16-char
# app password, not your real Gmail password>. Any provider with an SMTP
# relay (SendGrid, Mailgun, Postmark, AWS SES, ...) works unmodified by
# just changing these four values - see the mailer.js comment.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where the alert emails go. Required for any email to send at all.
ADMIN_ALERT_EMAIL=
