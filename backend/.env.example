# Copy to .env and fill in your values.

# Database
DATABASE_URL=postgres://hodlhorizon:hodlhorizon@localhost:5432/hodlhorizon

# Server
PORT=4000
FRONTEND_URL=http://localhost:3000

# Admin login (created by `npm run seed`)
ADMIN_EMAIL=admin@hodlhorizon.com
ADMIN_PASSWORD=change-this-password
JWT_SECRET=change-this-to-a-long-random-string

# Content generation provider: mock | openai | anthropic
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Scanning / publishing
SCAN_INTERVAL_MINUTES=15
AUTO_PUBLISH_MIN_SOURCES=2
ANALYSIS_INTERVAL_HOURS=12

# Market data
# CoinGecko works without a key; a free Demo key raises the rate limit.
COINGECKO_API_KEY=
# Twelve Data: indices, gold, forex, stocks
TWELVEDATA_API_KEY=
# Alpha Vantage: WTI, Brent, natural gas
STOCKS_DATA_API_KEY=
# Not used yet
FINNHUB_API_KEY=
MASSIVE_API_KEY=
# Return fixture data instead of calling Twelve Data / Alpha Vantage
MARKET_DATA_DRY_RUN=true

# Alert emails for scheduled single-source articles (leave ADMIN_ALERT_EMAIL blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_ALERT_EMAIL=
